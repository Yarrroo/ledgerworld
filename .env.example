# Every variable LedgerWorld reads. Names only: put values in .env (never committed).

# Airwallex (sandbox only; the production host is refused by code)
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_BASE_URL=
AIRWALLEX_MODE=
AIRWALLEX_CONNECTED=
AIRWALLEX_WEBHOOK_SECRET=
AIRWALLEX_API_VERSION=
AIRWALLEX_GLOBAL_ACCOUNT_ID=

# Model (any OpenAI-compatible API); the boost model is optional
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_NAME=
LLM_BOOST_API_KEY=
LLM_BOOST_BASE_URL=
LLM_BOOST_MODEL_NAME=

# Graph memory
ZEP_API_KEY=

# Storage and queue
LEDGER_DATABASE_URL=
REDIS_URL=

# Application
LEDGERWORLD_ROLE=
LEDGERWORLD_DEMO_TOKEN=
LEDGERWORLD_URL=
LEDGERWORLD_LLM_DAILY_USD=
LEDGERWORLD_FREEZE=
