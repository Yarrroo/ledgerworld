                        "transfer_currency", "transfer_method", "updated_at"]},
    "payout-replay": {"http": 400, "status": "request_id_duplicate",
                      "keys": ["code", "message", "source"]},
    "payout-lookup": {"http": 200, "status": "PROCESSING",
                      "keys": ["beneficiary_id", "created_at", "id", "reason", "reference",
