                          "sell_currency", "valid_to_at", "validity"]},
    "fx-conversion": {"http": 201, "status": "SETTLED",
                      "keys": ["buy_amount", "buy_currency", "client_rate", "conversion_id",
                               "created_at", "quote_id", "request_id", "sell_amount",
                               "sell_currency", "status", "updated_at"]},
    "fx-conversion-replay": {"http": 400, "status": "invalid_argument",
                             "keys": ["code", "message", "source"]},
    "fx-conversion-lookup": {"http": 200, "status": "SETTLED",
                             "keys": ["buy_amount", "buy_currency", "client_rate",
                                      "conversion_id", "created_at", "quote_id", "request_id",
                                      "sell_amount", "sell_currency", "status", "updated_at"]},
    "payout": {"http": 201, "status": "SCHEDULED",
