                               "transfer_amount", "transfer_currency", "transfer_method",
                               "updated_at"]},
    "payout-to-paid": {"http": 200, "status": "PAID",
                       "keys": ["beneficiary_id", "created_at", "id", "reason", "reference",
                                "request_id", "source_amount", "source_currency", "status",
                                "transfer_amount", "transfer_currency", "transfer_method",
                                "updated_at"]},
    "advance": {"http": 201, "status": "PENDING",
                "keys": ["amount", "currency", "id", "reference", "status"]}
  }
