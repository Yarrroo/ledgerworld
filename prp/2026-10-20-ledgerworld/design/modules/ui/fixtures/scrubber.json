    {"id": "phone", "width": 390, "expect": {"order": ["mode and branch labels", "scrubber and controls", "cash path", "action feed", "graph and actor inspector"], "graph_can_expand": true, "scrubber_keyboard": ["ArrowLeft", "ArrowRight", "Home", "End"]}}
