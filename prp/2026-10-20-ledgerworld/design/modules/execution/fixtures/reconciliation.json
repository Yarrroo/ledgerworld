{
 "fixture": "reconciliation",
 "about": "Provider state → ledger journals, and every mismatch as an incident, never an auto-correction (T13; g1 'reconciliation closes the advance'). The truth is GET by provider id. Journals reuse the ledger module's advance-journals.json for the advance; the payout settles the payroll reservation. USD minor units in the ledger, provider decimal strings on the wire.",
 "cases": [
  {"id": "advance-mode-a", "mode": "A",
   "leg": {"kind": "advance", "amount": 1000000, "request_id": "<h>-1-advance"},
   "provider": {"op": "connected_account_transfer", "status": "SETTLED", "amount": "10000.00", "currency": "USD"},
   "expect": {"journal": "j-adv-a-disburse (ledger advance-journals.json, posting by posting)", "reconciled": true, "receipt_label": "advance (connected-account transfer)", "K_p_after": 3200000}},
  {"id": "advance-mode-b", "mode": "B",
   "leg": {"kind": "advance", "amount": 1000000, "request_id": "<h>-1-advance"},
   "provider": {"op": "simulation/deposit/create", "status": "SETTLED", "amount": 10000.00, "reference": "advance inflow (sandbox simulation) <h>-1-advance"},
   "expect": {"journal": "j-adv-a-disburse", "reconciled": true, "receipt_label": "advance inflow (sandbox simulation)", "never_label": "lender disbursement through the provider"},
   "note": "the deposit has no request_id; the reference carries it and the lookup matches on it"},
  {"id": "payout-paid",
   "leg": {"kind": "payout", "amount": 5000000, "funded_by": "reservation:res-payroll-1", "request_id": "<h>-2-payout"},
   "provider": {"op": "transfer", "status_path": ["SCHEDULED", "PROCESSING", "SENT", "PAID"], "transfer_amount": "50000.00"},
   "expect": {"at_create": "reservation res-payroll-1 committed → pending_out 5,000,000", "at_PAID": "journal payroll settle: borrower-a/operating -5,000,000, x/payroll +5,000,000; reservation settled; obligation payroll-1 met", "reconciled": true}},
  {"id": "paid-then-failed",
   "leg": {"kind": "payout", "amount": 5000000, "request_id": "<h>-2-payout"},
   "provider": {"status_path": ["PAID", "FAILED", "CANCELLED"]},
   "expect": {"incident": {"kind": "paid_then_failed", "open": true}, "reconciled": false, "journals_added": 0, "proposed": "a reversing journal, posted only on the operator's confirm", "obligation": "payroll-1 back to open"}},
  {"id": "amount-mismatch",
   "leg": {"kind": "advance", "amount": 1000000},
   "provider": {"status": "SETTLED", "amount": "9999.99"},
   "expect": {"incident": {"kind": "amount_mismatch", "ledger": 1000000, "provider": 999999}, "journal": "none", "reconciled": false}},
  {"id": "currency-mismatch",
   "leg": {"kind": "payout", "amount": 5000000, "currency": "USD"},
   "provider": {"status": "PAID", "currency": "EUR"},
   "expect": {"incident": {"kind": "currency_mismatch"}, "journal": "none"}},
  {"id": "orphan-provider-object",
   "provider": {"op": "transfer", "request_id": "not-ours-1", "status": "PAID"},
   "expect": {"incident": {"kind": "unknown_provider_object"}, "journal": "none", "note": "listed during the reconcile sweep; never adopted into a leg"}},
  {"id": "repayment-mode-b", "mode": "B",
   "leg": {"kind": "repayment", "amount": 360000, "request_id": "<h>-3-repayment"},
   "provider": null,
   "expect": {"state_path": ["pending", "settled"], "journal": "j-adv-a-repay-w1", "receipt_label": "repayment (simulated)", "provider_id": null, "reconciled": true}},
  {"id": "fx-settled",
   "leg": {"kind": "fx", "buy": {"amount": 1000000, "currency": "EUR"}, "sell_currency": "USD", "request_id": "<h>-4-fx"},
   "provider": {"status": "SETTLED", "buy_amount": "10000.00", "sell_amount": "11100.00", "client_rate": "1.1100"},
   "expect": {"journal": "fx: borrower-a/operating USD -1,110,000 · x/fx USD +1,110,000 · x/fx EUR -1,000,000 · borrower-a/eur EUR +1,000,000 (balanced per currency)", "reconciled": true}}
 ],
 "sweep": {
  "when": "every 60 s while any leg is submitted or unknown, and once after each run",
  "reads": "GET by provider id for each open leg; list by request_id for each unknown leg",
  "writes": "state, journal (same transaction as settled), incidents; never edits a posted journal"
 }
}
