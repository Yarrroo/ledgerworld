{
 "fixture": "canonical-requests",
 "about": "The requests T15 runs once on the fake and once on the sandbox, in this order, then diffs response key sets and status values. 'basis' says where each body comes from: docs = read in the provider docs (research note 22-23 Oct); assumed = our best reading, to be confirmed live and recorded in docs/airwallex-contract.md. Any difference is fixed in the fake and its tests, never by branching callers. Amounts are built from minor units by the one converter.",
 "api_version": "2024-09-27",
 "requests": [
  {"id": "login", "method": "POST", "path": "/api/v1/authentication/login", "headers": ["x-client-id", "x-api-key"], "body": null, "basis": "docs",
   "expect": {"http": 201, "keys_min": ["token", "expires_at"]}},
  {"id": "balances", "method": "GET", "path": "/api/v1/balances/current", "basis": "docs",
   "expect": {"http": 200, "item_keys_min": ["currency", "available_amount", "pending_amount"]}},
  {"id": "global-accounts", "method": "GET", "path": "/api/v1/global_accounts", "basis": "docs",
   "expect": {"http": 200, "note": "Mode B needs one in USD; record its id shape, never its bank details"}},
  {"id": "connected-probe", "method": "GET", "path": "connected accounts list (record the path)", "basis": "assumed",
   "expect": {"note": "200 with an ACTIVE account → Mode A (200 with none, or no status → Mode B); 401/403/404 → Mode B; record the provider's answer verbatim (no account data)"}},
  {"id": "fx-quote", "method": "POST", "path": "/api/v1/fx/quotes/create", "basis": "docs",
   "body": {"sell_currency": "USD", "buy_currency": "EUR", "buy_amount": "10000.00", "validity": "MIN_15"}, "from_minor": {"buy": 1000000},
   "expect": {"http": 200, "keys_min": ["quote_id", "client_rate"], "note": "record the real key names; the fake follows them"}},
  {"id": "fx-conversion", "method": "POST", "path": "/api/v1/fx/conversions/create", "basis": "docs",
   "body": {"request_id": "canon-fx-<run>", "sell_currency": "USD", "buy_currency": "EUR", "buy_amount": "10000.00", "quote_id": "<from fx-quote>"},
   "expect": {"http": 201, "status_in": ["SCHEDULED", "SETTLED"]}},
  {"id": "fx-conversion-replay", "method": "POST", "path": "/api/v1/fx/conversions/create", "basis": "docs",
   "body": "same as fx-conversion, same request_id",
   "expect": {"rejected": true, "record": "the real http status and code"}},
  {"id": "fx-conversion-lookup", "method": "GET", "path": "/api/v1/fx/conversions?request_id=canon-fx-<run>", "basis": "docs",
   "expect": {"count": 1}},
  {"id": "payout", "method": "POST", "path": "/api/v1/transfers/create", "basis": "docs",
   "body": {"request_id": "canon-pay-<run>", "beneficiary_id": "<the sandbox test beneficiary>", "source_currency": "USD", "transfer_currency": "USD", "transfer_amount": "100.00", "transfer_method": "LOCAL", "reason": "business_expenses", "reference": "ledgerworld canon"},
   "from_minor": {"transfer": 10000},
   "expect": {"http": 201, "status": "SCHEDULED", "keys_min": ["id", "request_id", "status"]}},
  {"id": "payout-replay", "method": "POST", "path": "/api/v1/transfers/create", "basis": "docs",
   "body": "same as payout, same request_id",
   "expect": {"http": 400, "code": "request_id_duplicate"}},
  {"id": "payout-lookup", "method": "GET", "path": "/api/v1/transfers?request_id=canon-pay-<run>", "basis": "docs",
   "expect": {"count": 1, "same_id_as": "payout"}},
  {"id": "payout-to-paid", "method": "POST", "path": "/api/v1/simulation/transfers/{id}/transition", "basis": "docs",
   "body_sequence": [{"next_status": "PROCESSING"}, {"next_status": "SENT"}, {"next_status": "PAID"}],
   "expect": {"final_status": "PAID", "balance_delta_minor_since_before_payout": -10000}},
  {"id": "advance-mode-b", "mode": "B", "method": "POST", "path": "/api/v1/simulation/deposit/create", "basis": "docs",
   "body": {"global_account_id": "<from global-accounts>", "amount": 10000.00, "reference": "advance inflow (sandbox simulation) canon-<run>"},
   "from_minor": {"amount": 1000000},
   "expect": {"status": "SETTLED", "balance_delta_minor": 1000000, "record": "whether a string amount is also accepted, and how long until balances/current moves"}},
  {"id": "advance-mode-a", "mode": "A", "method": "POST", "path": "/api/v1/connected_account_transfers/create", "basis": "docs",
   "body": {"request_id": "canon-adv-<run>", "amount": "10000.00", "currency": "USD", "destination": "<borrower-a connected account>"},
   "expect": {"http": 201}}
 ],
 "after": {
  "one_movement": "exactly one payout and one conversion exist for their request_ids; balances moved once",
  "contract_doc": "docs/airwallex-contract.md lists: date, api_version, every 'assumed' row with the real answer, every key set difference and the fake commit that fixed it",
  "never": "a real account number, beneficiary bank detail, token or key in the contract doc or any log"
 }
}
